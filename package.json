{
  "name": "dream-bike-garage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:toss": "vite --mode toss",
    "build:toss": "tsc -b && vite build --mode toss && ait build",
    "deploy:toss": "ait deploy",
    "build:android": "tsc -b && vite build --mode android && cap sync android",
    "icons:android": "node scripts/android-icons.mjs"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.8.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "3.8.0",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
